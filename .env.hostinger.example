# Örnek ortam değişkenleri — gerçek değerleri repoya commit ETMEYİN

# Geliştirme
DATABASE_URL="mysql://USER:PASS@localhost:3306/rdkhaber"

# Production build (Hostinger build worker — uzak MySQL)
# DATABASE_URL="mysql://USER:PASS@srv2024.hstgr.io:3306/DBNAME"

# Production runtime (Hostinger Node — localhost MySQL)
# DATABASE_URL="mysql://USER:PASS@localhost:3306/DBNAME"

AUTH_SECRET="CHANGE_ME_LONG_RANDOM"
AUTH_TRUST_HOST=true
AUTH_URL="https://duzceradikal.com"
NEXTAUTH_URL="https://duzceradikal.com"
NEXT_PUBLIC_SITE_URL="https://duzceradikal.com"
NODE_ENV=production

# Yüklenen görseller — uygulama klasörünün dışında tutun (zip deploy silmesin)
# UPLOAD_DIR=/home/u534260973/rdkhaber-uploads

# Opsiyonel — canlı skor API kimlik bilgisi (kaynak kodda varsayılan kullanılmaz)
# LIVESCORE_API_AUTH="user:pass"

# Cloudflare Turnstile (form captcha — prod'da zorunlu)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Health endpoint koruması (Authorization: Bearer <secret>)
# HEALTH_CHECK_SECRET=""

# Google OAuth (NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=1 ile giriş butonu görünür)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=0

# Cron uç noktaları (Authorization: Bearer CRON_SECRET)
# CRON_SECRET="CHANGE_ME_CRON_SECRET"

# YSK açık veri API (seçim merkezi senkronizasyonu)
# YSK_API_BASE="https://acikveri.ysk.gov.tr/api"
# YSK_SECIM_ID=20260
# YSK_SECIM_TURU=2
# YSK_IL_ID=81
# YSK_FOCUS_ILCE="DÜZCE MERKEZ"

# SMTP şifre şifreleme (32 bayt hex — openssl rand -hex 32)
# SECRET_ENCRYPTION_KEY=""

# Sentry (opsiyonel)
# SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE=0.1

# GitHub Actions deploy (Deploy Hostinger workflow) — repoya değil, GitHub Secrets'a ekleyin:
# HOSTINGER_SSH_HOST, HOSTINGER_SSH_USER, HOSTINGER_SSH_KEY, HOSTINGER_DEPLOY_PATH
# DATABASE_URL_BUILD (build: srv*.hstgr.io), AUTH_SECRET, NEXT_PUBLIC_SITE_URL

# Cron uç noktaları (Authorization: Bearer CRON_SECRET)
# GET /api/cron/publish-scheduled — zamanlanmış yayın
# GET /api/cron/backup-db — veritabanı yedeği
# GET /api/cron/haber-bot — haber botu

# Web push (VAPID)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@duzceradikal.com

# Sosyal otomatik paylaşım
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
# TWITTER_WEBHOOK_URL=

# Meilisearch (opsiyonel gelişmiş arama)
# MEILISEARCH_HOST=
# MEILISEARCH_API_KEY=

# Redis önbellek ve rate limit (prod'da önerilir)
# REDIS_URL=

# Azure Speech — yerli Türkçe nöral ses (MAI/çok dilli sesler İngilizce aksan verir)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_VOICE=tr-TR-EmelNeural
# AZURE_SPEECH_STYLE=none
# AZURE_SPEECH_STYLEDEGREE=0.12
# AZURE_SPEECH_RATE=98%
# AZURE_SPEECH_ENDPOINT=

# Cloudflare — panelden etkinleştirin (DNS + proxy + cache rules)
